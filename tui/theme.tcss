/* BitCraft TUI theme: pitch black, Dark Knight vibes.
 *
 * Near-black background, high-contrast light text, one muted gold accent
 * for headers and primary signal, deep red reserved for high-severity
 * alerts only. See docs/tui_design.md for the full rationale.
 */

Screen {
    background: #000000;
    color: #e6e6e6;
}

Header {
    background: #000000;
    color: #d4af37;
    text-style: bold;
}

Footer {
    background: #000000;
    color: #7a7a7a;
}

/* --- Splash ----------------------------------------------------------- */

#splash {
    width: 100%;
    height: 100%;
    align: center middle;
}

#splash-spacer-top,
#splash-spacer-bottom {
    height: 1fr;
}

#splash-logo {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #d4af37;
    text-style: bold;
}

#splash-hint {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #7a7a7a;
    margin-top: 2;
}

/* --- Boot ------------------------------------------------------------- */

#boot {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 1 2;
}

#boot-logo {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #d4af37;
    text-style: bold;
}

#boot-shimmer {
    width: 100%;
    height: 1;
    content-align: center middle;
    color: #d4af37;
    margin: 1 0;
}

#boot-progress {
    width: 60%;
    margin: 1 0;
}

#boot-log {
    width: 80%;
    height: 14;
    background: #050505;
    border: round #1a1a1a;
    color: #e6e6e6;
}

#boot-hint {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #7a7a7a;
    margin-top: 1;
}

/* --- Dashboard -------------------------------------------------------- */

#dashboard {
    width: 100%;
    height: 1fr;
    padding: 0 1;
}

#size-guard {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: #d4af37;
    text-style: bold;
}

#kpi-summary {
    height: 4;
    background: #050505;
    border: round #1a1a1a;
    margin-bottom: 1;
}

#kpi-row {
    width: 100%;
    height: 100%;
    align: center middle;
}

.kpi-cell {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #e6e6e6;
}

#dashboard-body {
    height: 1fr;
}

#left-col {
    width: 28;
    height: 100%;
    margin-right: 1;
}

#filter-panel {
    width: 100%;
    height: auto;
    background: #050505;
    border: round #1a1a1a;
    padding: 1;
}

#score-histogram {
    width: 100%;
    height: 1fr;
    background: #050505;
    border: round #1a1a1a;
    padding: 1;
    margin-top: 1;
    color: #7a7a7a;
}

#center-col {
    width: 1fr;
    height: 100%;
}

#alert-list {
    width: 100%;
    height: 1fr;
    background: #050505;
    border: round #1a1a1a;
}

#alert-status {
    height: 1;
    color: #7a7a7a;
    padding: 0 1;
}

#alert-empty {
    height: auto;
}

#preview-pane {
    width: 36;
    height: 100%;
    background: #050505;
    border: round #1a1a1a;
    padding: 1;
    margin-left: 1;
    color: #e6e6e6;
}

.filter-label {
    color: #7a7a7a;
    margin-top: 1;
}

#filter-panel Input {
    width: 100%;
    background: #000000;
    border: solid #1a1a1a;
}

#filter-panel Input:focus {
    border: solid #d4af37;
}

/* --- Alert detail / graph / threats ---------------------------------- */

#alert-detail {
    width: 100%;
    height: 1fr;
    padding: 0 1;
}

#detail-body {
    width: 100%;
    height: 1fr;
    background: #050505;
    border: round #1a1a1a;
    padding: 1;
}

#graph-view {
    background: #050505;
    border: round #1a1a1a;
    color: #e6e6e6;
    padding: 1;
    height: 1fr;
}

#graph-title {
    padding: 1 2 0 2;
    text-style: bold;
}

#threats {
    width: 100%;
    height: 1fr;
    padding: 0 1;
}

#threat-posture {
    height: auto;
    color: #e6e6e6;
    padding: 0 1;
}

#threat-stack {
    height: 1;
    margin: 0 1 1 1;
}

#threat-body {
    height: 1fr;
}

#threat-queue {
    width: 1fr;
    height: 100%;
    background: #050505;
    border: round #1a1a1a;
    padding: 1;
    margin-right: 1;
}

#threat-drivers {
    width: 28;
    height: 100%;
    background: #050505;
    border: round #1a1a1a;
    padding: 1;
    margin-right: 1;
}

#threat-communities {
    width: 36;
    height: 100%;
    background: #050505;
    border: round #1a1a1a;
}

#threat-signals,
#threat-coverage,
#threat-timeline {
    height: auto;
    background: #050505;
    border: round #1a1a1a;
    padding: 1;
    margin-top: 1;
    color: #e6e6e6;
}

/* --- Shared ----------------------------------------------------------- */

.accent {
    color: #d4af37;
    text-style: bold;
}

.alert-high {
    color: #b3261e;
    text-style: bold;
}

.alert-medium {
    color: #d4af37;
}

.alert-low {
    color: #7a7a7a;
}

.modeled-badge {
    color: #6a6a6a;
    text-style: italic;
}
