/* BitCraft TUI theme: pitch black, Dark Knight vibes.
 *
 * Near-black background, high-contrast light text, one muted gold accent
 * for headers and primary signal, deep red reserved for high-severity
 * alerts only. See docs/tui_design.md for the full rationale.
 */

Screen {
    background: #000000;
    color: #e6e6e6;
}

Header {
    background: #000000;
    color: #d4af37;
    text-style: bold;
}

Footer {
    background: #000000;
    color: #7a7a7a;
}

#kpi-summary,
#filter-panel,
#alert-list,
#alert-detail-panel,
#graph-view {
    background: #050505;
    border: round #1a1a1a;
    color: #e6e6e6;
}

.accent {
    color: #d4af37;
}

.alert-high {
    color: #b3261e;
    text-style: bold;
}

.alert-medium {
    color: #d4af37;
}

.alert-low {
    color: #7a7a7a;
}

.modeled-badge {
    color: #6a6a6a;
    text-style: italic;
}
