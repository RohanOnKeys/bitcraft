  <metadata>
    <id>bitcraft</id>
    <version>0.1.0</version>
    <title>BitCraft</title>
    <authors>Rohan Pattanayak, Jagadish Pattnaik, Shreya Mishra, Shreya Mohanty, Ashutosh Badapada, Rosalin Nayak</authors>
    <owners>Rohan Pattanayak</owners>
